<div id="pageLevel" class="page">
    <div class="glass" style="margin:16px; text-align:center;">
        <div style="font-size:48px; font-weight:700; color:#d4a843;" id="levelNumber">LV1</div>
        <div style="font-size:20px; font-weight:600; color:#3d2b1a;" id="levelName">见习生</div>
        <div class="level-exp-bar"><div class="exp-fill" id="expFill" style="width:0%;"></div></div>
        <div style="font-size:13px; color:#3d2b1a;"><span id="currentExp">0</span> / <span id="nextExp">20</span> EXP</div>
    </div>
    <div class="glass" style="margin:16px; text-align:center;">
        <h3 style="color:#3d2b1a;">⭐ 信誉分</h3>
        <div style="font-size:32px; font-weight:700; color:#d4a843;" id="currentCredit">0</div>
        <div style="font-size:13px; color:#b8a68b;">目标 G4 · 信誉典范（200分）</div>
        <div class="level-exp-bar" style="margin-top:8px;">
            <div class="exp-fill" id="creditFill" style="width:0%; background:#d4a843;"></div>
        </div>
        <div style="font-size:12px; color:#b8a68b; margin-top:4px;">
            <span id="currentCreditLabel">0</span> / <span id="maxCredit">200</span>
        </div>
    </div>
    <div class="glass">
        <button id="achievementToggleBtn" class="achievement-toggle-btn" onclick="toggleAchievementPanel()">
            🏅 查看成就
        </button>
        <div id="achievementPanel" style="display:none; margin-top:12px;">
            <div id="achievementList"></div>
        </div>
    </div>
    <div class="glass">
        <h3>📋 每日任务</h3>
        <div class="settings-item"><span>📌 每日登录</span><span>+2 EXP</span><button class="btn-primary" id="dailyBonusBtn" onclick="claimDaily()" style="padding:4px 16px; font-size:12px;">领取</button></div>
        <div class="settings-item"><span>📝 发布帖子</span><span>+3 EXP</span></div>
        <div class="settings-item"><span>💬 发表评论</span><span>+1 EXP</span></div>
        <div class="settings-item"><span>❤️ 帖子被赞</span><span>+2 EXP</span></div>
        <div class="settings-item"><span>🔑 认证管理员</span><span>+30 EXP</span></div>
    </div>
</div>

<div id="pageDM" class="page">
    <div class="glass" style="margin:16px;">
        <h2>💬 私信</h2>
        <div id="dmConversationList"></div>
    </div>
</div>

<div id="pageDMChat" class="page">
    <div class="post-detail" style="padding:16px;">
        <button class="btn-secondary" onclick="switchPage('dm')" style="margin-bottom:8px;">‹ 返回</button>
        <h3 id="dmChatTitle" style="color:#3d2b1a;">对话</h3>
        <div id="dmMessages" style="max-height:400px; overflow-y:auto; margin:12px 0; padding:8px; background:rgba(255,255,255,0.2); border-radius:16px;"></div>
        <div style="display:flex; gap:8px;">
            <input id="dmInput" placeholder="输入消息..." style="flex:1; margin-bottom:0;">
            <button class="btn-primary" onclick="sendDM()">发送</button>
        </div>
        <div id="dmWarning" style="font-size:13px; color:#e67e22; margin-top:8px; display:none;"></div>
        <div style="margin-top:12px; padding:10px; background:rgba(255,0,0,0.05); border-radius:12px; font-size:12px; color:#999;">
            ⚠️ 安全提示：若脱离本站进行私下交易，所有损失本站不承担责任 · 当心网络诈骗 · 本站不会将用户隐私信息提供给任何个体/企业/群体
        </div>
    </div>
</div>

<div id="pageReports" class="page">
    <div class="glass" style="margin:16px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h2>🛡️ 管理后台</h2>
            <button class="btn-secondary" onclick="loadReports(); loadPendingPosts();" style="font-size:13px; padding:4px 16px;">刷新</button>
        </div>
        <div class="admin-tabs">
            <button class="admin-tab active" onclick="switchAdminTab('reports')">📋 举报管理</button>
            <button class="admin-tab" onclick="switchAdminTab('pending')">⏳ 待审核</button>
        </div>
        <div id="adminReportsPanel">
            <div id="reportList"><p style="color:#b8a68b;text-align:center;padding:20px;">加载中...</p></div>
        </div>
        <div id="adminPendingPanel" style="display:none;">
            <div id="pendingList"><p style="color:#b8a68b;text-align:center;padding:20px;">加载中...</p></div>
        </div>
    </div>
</div>

<button id="floatPostBtn" class="float-post-btn" onclick="openPostModal()">
    <span style="font-size:28px; line-height:1;">+</span>
</button>

<div class="bottom-nav">
    <button class="active" onclick="switchPage('feed')"><span class="icon">📄</span>首页</button>
    <button onclick="switchPage('profile')"><span class="icon">👤</span>用户</button>
    <button onclick="switchPage('level')"><span class="icon">🏆</span>等级</button>
    <button onclick="switchPage('dm')"><span class="icon">💬</span>私信</button>
</div>

<div class="modal" id="authModal">
    <div class="modal-box">
        <h2 id="authTitle">登录</h2>
        <input id="authUsername" placeholder="用户名">
        <input id="authPassword" type="password" placeholder="密码">
        <input id="authEmail" placeholder="邮箱（选填）" style="display:none;">
        <div style="font-size:12px; color:#3d2b1a; margin-bottom:12px;">
            <label><input type="checkbox" id="agreePrivacy" checked> 我已阅读并同意 <a href="/privacy" target="_blank">《樟嘉评级隐私政策》</a></label>
            <div style="margin-top:4px;">若未满14岁，请在监护人陪同下使用。</div>
        </div>
        <div class="modal-actions">
            <button class="btn-secondary" onclick="closeAuth()">取消</button>
            <button class="btn-primary" id="authSubmitBtn" onclick="submitAuth()">登录</button>
        </div>
        <p style="margin-top:12px; font-size:13px; color:#b8a68b; text-align:center;" id="authToggle">没有账号？<span style="color:#d4a843;cursor:pointer;" onclick="toggleAuthMode()">注册</span></p>
    </div>
</div>

<div class="modal" id="postModal">
    <div class="modal-box">
        <h2>📝 发布帖子</h2>
        <select id="postType" onchange="toggleGradeCodeFormat()" style="margin-bottom:12px;">
            <option value="grade">📜 评级帖</option>
            <option value="report">📋 综合报</option>
        </select>
        <input id="postTitle" placeholder="标题">
        <textarea id="postContent" placeholder="内容"></textarea>
        <input id="postGradeCode" placeholder="评级码（选填）" maxlength="30" style="margin-bottom:12px;" oninput="updateGradeCodeLength()">
        <div id="gradeCodeHint" style="font-size:12px; color:#b8a68b; margin-bottom:12px;">纯数字，8-12位</div>
        <select id="postTag">
            <option value="">选择分类</option>
            <option value="先秦">先秦</option><option value="秦汉">秦汉</option><option value="三国两晋南北朝">三国两晋南北朝</option>
            <option value="隋唐">隋唐</option><option value="五代十国">五代十国</option><option value="两宋">两宋</option>
            <option value="辽金西夏">辽金西夏</option><option value="元明">元明</option><option value="清代">清代</option>
            <option value="花钱/厌胜钱">花钱/厌胜钱</option><option value="外国古币">外国古币</option><option value="樟嘉专区">樟嘉专区</option>
        </select>
        <input type="file" id="postImages" accept="image/*" multiple>
        <div class="modal-actions">
            <button class="btn-secondary" onclick="closePostModal()">取消</button>
            <button class="btn-primary" id="submitPostBtn" onclick="submitPost()">发布</button>
        </div>
    </div>
</div>

